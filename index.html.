<div class="modalbg" id="userModal"><div class="modal"><div class="modalhead"><h2 id="userTitle">Tambah Pengguna</h2><button class="close" data-close="userModal">✕</button></div><form id="userForm"><input id="oldId" type="hidden"><div class="formgrid"><div class="field"><label>ID</label><input id="uId" required></div><div class="field"><label>Nama lengkap</label><input id="uName" required></div><div class="field"><label>Kelas / Jabatan</label><input id="uRole" required></div><div class="field"><label>Nomor identitas</label><input id="uIdentity"></div><div class="field"><label>Username</label><input id="uUsername" required></div><div class="field"><label>Status</label><select id="uStatus"><option>Aktif</option><option>Nonaktif</option></select></div></div><div class="notice">Pengguna baru memakai PIN demo 123456.</div><button class="btn cyan">Simpan Pengguna</button></form></div></div><div class="toast" id="toast"></div>
<script>
'use strict';const $=id=>document.getElementById(id),KEY='smartAttendanceDemo_v1';const demo=[['ST001','Andi Pratama','Kelas XI IPA 1','NIS001','andi'],['ST002','Bunga Lestari','Kelas XI IPA 1','NIS002','bunga'],['ST003','Citra Amelia','Kelas XI IPA 2','NIS003','citra'],['ST004','Dimas Saputra','Kelas XI IPA 2','NIS004','dimas'],['ST005','Eka Putri','Kelas XI IPS 1','NIS005','eka'],['ST006','Farhan Akbar','Kelas XI IPS 1','NIS006','farhan'],['ST007','Gita Maharani','Kelas XI IPS 2','NIS007','gita'],['ST008','Hendra Wijaya','Kelas XI IPS 2','NIS008','hendra'],['ST009','Intan Permata','Kelas XII IPA 1','NIS009','intan'],['ST010','Joko Firmansyah','Kelas XII IPA 1','NIS010','joko']].map(a=>({id:a[0],name:a[1],role:a[2],identity:a[3],username:a[4],status:'Aktif',pin:'123456',demo:true}));let users=[],records=[],leaves=[],settings={workStart:'08:00',tolerance:10,workEnd:'16:00'},stream=null,pin='',fails=0,locked=0;
const today=()=>{let p=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Jakarta',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()).reduce((a,x)=>(a[x.type]=x.value,a),{});return `${p.year}-${p.month}-${p.day}`},time=()=>new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Jakarta',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date()),fmtDate=d=>new Date(d+'T12:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(s){$('toast').textContent=s;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2400)}function save(){try{records=normalizeRecords(records);localStorage.setItem(KEY,JSON.stringify({users,records,leaves,settings}));return true}catch(e){toast('Gagal menyimpan data browser.');return false}}function normalizeRecords(list){let map=new Map();for(const raw of (Array.isArray(list)?list:[])){if(!raw||!raw.userId||!raw.date)continue;let k=raw.userId+'|'+raw.date,old=map.get(k);if(!old)map.set(k,{...raw,id:raw.id||idgen()});else{old.checkIn=old.checkIn||raw.checkIn||'';old.checkOut=raw.checkOut||old.checkOut||'';old.method=old.method||raw.method||'PIN Demo';old.status=old.status==='Terlambat'||raw.status==='Terlambat'?'Terlambat':(old.status||raw.status||'Hadir')}}return [...map.values()]}function load(){try{let d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.users)){users=d.users;records=normalizeRecords(d.records);leaves=d.leaves||[];settings={...settings,...d.settings}}else users=demo.map(x=>({...x}))}catch(e){users=demo.map(x=>({...x}));records=[];leaves=[]} $('workStart').value=settings.workStart;$('tolerance').value=settings.tolerance;$('workEnd').value=settings.workEnd}function idgen(){return 'A'+Date.now().toString(36)+Math.random().toString(36).slice(2,5)}function who(id){return users.find(u=>u.id===id)}function rec(id){return records.f